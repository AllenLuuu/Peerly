# Model used when an Agent definition omits its model.
PEERLY_MODEL_PROVIDER=openai-compatible
PEERLY_MODEL_ID=
# PEERLY_AGENT_DATA_DIR=E:/path/to/peerly-agent-data

# OpenAI-compatible endpoint. The API mode defaults to chat-completions.
# OPENAI_BASE_URL=https://models.example.com/v1
# OPENAI_API_KEY=
# PEERLY_OPENAI_API=chat-completions

# Built-in Pi providers can be used instead of openai-compatible. Their
# credentials use the provider's standard environment variables.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

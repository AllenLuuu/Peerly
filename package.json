{
  "name": "peerly",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @peerly/server --filter @peerly/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "runtime:cli": "pnpm --filter @peerly/runtime-cli... build && pnpm --filter @peerly/runtime-cli start",
    "server:start": "pnpm --filter @peerly/server... build && pnpm --filter @peerly/server start",
    "smoke:agent": "pnpm --filter @peerly/server... build && node --env-file-if-exists=.env.local scripts/agent-chat-smoke.mjs",
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.3.0",
    "eslint": "^10.10.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}

{
  "name": "@peerly/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists=../../.env.local --watch --import tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=../../.env.local dist/index.js"
  },
  "dependencies": {
    "@peerly/agent-protocol": "workspace:*",
    "@peerly/agent-runtime": "workspace:*",
    "@peerly/contracts": "workspace:*",
    "@fastify/cookie": "^11.0.0",
    "fastify": "^5.0.0",
    "socket.io": "^4.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.5"
  }
}

# Agent Definition 未指定模型时使用的默认模型。
PEERLY_MODEL_PROVIDER=openai-compatible
PEERLY_MODEL_ID=
# PEERLY_AGENT_DATA_DIR=E:/path/to/peerly-agent-data

# OpenAI-compatible 接口地址。API 模式默认为 chat-completions。
# OPENAI_BASE_URL=https://models.example.com/v1
# OPENAI_API_KEY=
# PEERLY_OPENAI_API=chat-completions

# 也可以使用 Pi 内置 provider。凭证使用对应 provider 的标准环境变量。
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Peerly 后端默认配置。
# PEERLY_SERVER_DATA_DIR=E:/path/to/peerly-server-data
# PEERLY_SERVER_HOST=127.0.0.1
# PEERLY_SERVER_PORT=3000
